# Storefront Environment Variables for MiniOxygen (Local Dev)
# Run `npx shopify hydrogen link` or `npx shopify hydrogen env pull` to populate from Shopify Oxygen
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STORE_DOMAIN=intern-ha-duc-duong-store.myshopify.com
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/authentication
SHOP_ID=
SESSION_SECRET=example-secret-key-min-32-chars-long
