#!/bin/sh

echo "🔍 [LimiDaily Pre-Commit Hook] Đang quét mã nguồn và kiểm tra bảo mật..."

# ------------------------------------------------------------------------------
# 1. SECRET SCANNER - RÀO CHẮN BẢO MẬT CHỐNG RÒ RỈ THÔNG TIN NHẠY CẢM
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# A. Kiểm tra tên tệp nhạy cảm
LEAKED_ENV=$(echo "$STAGED_FILES" | grep -E "(^|/)\.env($|\..*)" | grep -v "\.env\.example$" || true)
if [ -n "$LEAKED_ENV" ]; then
  echo ""
  echo "🚨 [SECURITY VIOLATION] Phát hiện tệp biến môi trường nhạy cảm đang được stage:"
  echo "$LEAKED_ENV"
  echo "❌ TUYỆT ĐỐI CẤM commit tệp .env lên Git repository công khai!"
  echo "👉 Vui lòng hủy stage: git reset HEAD <file> và kiểm tra lại .gitignore"
  echo ""
  exit 1
fi

LEAKED_SECRETS=$(echo "$STAGED_FILES" | grep -E "(\.pem|\.key|\.pfx|\.cert|id_rsa|credentials|\.shopify/)" || true)
if [ -n "$LEAKED_SECRETS" ]; then
  echo ""
  echo "🚨 [SECURITY VIOLATION] Phát hiện khóa bí mật / tệp chứng chỉ / cấu hình cục bộ:"
  echo "$LEAKED_SECRETS"
  echo "❌ Không được phép commit các tệp chứng chỉ hoặc cấu hình .shopify lên Git!"
  echo "👉 Vui lòng hủy stage: git reset HEAD <file>"
  echo ""
  exit 1
fi

# B. Kiểm tra nội dung staged diff chống hardcode private tokens (30+ ký tự)
LEAKED_TOKENS=$(git diff --cached | grep -E "shpat_[a-zA-Z0-9]{30,}" || true)
if [ -n "$LEAKED_TOKENS" ]; then
  echo ""
  echo "🚨 [SECURITY VIOLATION] Phát hiện chuỗi token đặc quyền 'shpat_...' thật trong staged code:"
  echo "$LEAKED_TOKENS"
  echo "❌ Tuyệt đối không hardcode Private Storefront API Token vào mã nguồn!"
  echo "👉 Hãy sử dụng biến môi trường SESSION_SECRET / PRIVATE_STOREFRONT_API_TOKEN trên Shopify Admin Oxygen."
  echo ""
  exit 1
fi

# ------------------------------------------------------------------------------
# 2. CODE QUALITY GATES (TYPESCRIPT STRICT & ESLINT)
# ------------------------------------------------------------------------------
NPX_BIN="npx"
NPM_BIN="npm"
if [ -n "$COMSPEC" ] || [ -n "$WINDIR" ] || [ -n "$SYSTEMROOT" ]; then
  NPX_BIN="npx.cmd"
  NPM_BIN="npm.cmd"
fi

echo "🛡️  [Quality Gate] 1/2: Đang chạy TypeScript Typecheck..."
"$NPM_BIN" run typecheck
if [ $? -ne 0 ]; then
  echo "❌ [TypeScript Error] Phát hiện lỗi kiểu dữ liệu! Vui lòng sửa triệt để trước khi commit."
  exit 1
fi

echo "🧹 [Quality Gate] 2/2: Đang chạy ESLint qua lint-staged..."
"$NPX_BIN" lint-staged
if [ $? -ne 0 ]; then
  echo "❌ [ESLint Error] Phát hiện lỗi quy chuẩn cú pháp mã nguồn!"
  exit 1
fi

echo "✅ [Security & Quality Gate] Vượt qua 100% kiểm tra an toàn và chất lượng! Cho phép commit."
